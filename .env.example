# paygate settings. Copy to .env and fill in:
#
#   ./scripts/run.sh env     creates .env and generates every CHANGE_ME secret for you
#
# Never commit .env. In production, load secrets from a secret manager.

# ---- Process ----
HTTP_ADDR=:8080
# "all", or a comma list: merchant,auth,provider,payment,refund,ledger,webhook,reconciliation,payout,kyc
MODULES=all
# memory (MODULES=all only) or nats
BUS=memory
NATS_URL=nats://localhost:4222

# ---- Data ----
# Your Postgres user, password and database (./scripts/run.sh db creates the database).
DATABASE_URL=postgres://DB_USER:DB_PASSWORD@localhost:5432/gateway?sslmode=disable
# DB_URL_AUTH=postgres://DB_USER:DB_PASSWORD@db-host:5432/gw_auth?sslmode=disable   (database per service)

# ---- Auth ----
# Ed25519 key pair: go run ./cmd/paygate keygen
# Private key: ONLY the auth service.
AUTH_SIGNING_KEY=CHANGE_ME
# Public key(s): EVERY service. Comma-separate old,new while rotating.
AUTH_PUBLIC_KEYS=CHANGE_ME
AUTH_KEY_CACHE_TTL=30s
# API key pepper (auth only), at least 32 random characters: openssl rand -hex 32
# To rotate: move it to API_KEY_PEPPER_PREVIOUS, set a new one, increase the version.
API_KEY_PEPPER=CHANGE_ME
API_KEY_PEPPER_VERSION=1
# First super_admin (every platform permission), seeded on start while no
# active super_admin exists. Password: at least 12 characters.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
BOOTSTRAP_ADMIN_NAME=Administrator

# Default role of every new merchant account ("merchant"). Seeded ONCE, the
# first time the role is created; afterwards platform staff edit it with
# /admin/roles (audience=merchant). Empty = the built-in list.
MERCHANT_DEFAULT_PERMISSIONS=payments:read,payments:write,refunds:write,balance:read,webhooks:write,apikeys:manage,team:manage,roles:read,roles:manage,kyc:read,kyc:write,payouts:read,payouts:write,disputes:read,disputes:write

# ---- Sign in with Google / Apple (empty = disabled) ----
# Client ids of YOUR apps, comma-separated: Google web / Android / iOS client ids;
# Apple: iOS bundle id and/or web Services ID.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# ---- Email (verification codes, password reset links, security notices) ----
# Any email provider with SMTP (Amazon SES, Mailgun, Zoho, Google Workspace...).
# Without SMTP_HOST emails are only written to the log (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM="paygate <no-reply@example.com>"
# Your dashboard: reset links point to <DASHBOARD_URL>/reset-password?token=...
DASHBOARD_URL=http://localhost:3000
PASSWORD_RESET_TTL=30m

# ---- SMS: send.et (verification codes by SMS; optional) ----
# send.et is an SMS gateway (it does not send email). Empty key = codes by email only.
SENDET_API_KEY=
SENDET_SENDER=Paygate
SENDET_BASE_URL=https://api.send.et/v1

# ---- Other secrets ----
# 32 bytes, base64: openssl rand -base64 32. Encrypts webhook secrets and
# authenticator (MFA) secrets.
DATA_ENCRYPTION_KEY=CHANGE_ME

# ---- Providers ----
# Public address of this gateway (hosted checkout links, provider callbacks).
PUBLIC_BASE_URL=http://localhost:8080
# Live routing: payment method -> providers in order of preference (failover).
# Methods: telebirr, cbe_birr, mpesa, card, bank_transfer. Only installed
# provider adapters can be listed (see docs/PROVIDER_ONBOARDING.md). Test mode
# always uses the built-in sandbox. Example:
#   PROVIDER_ROUTES=telebirr=telebirr;cbe_birr=cbebirr;mpesa=mpesa;card=ethswitch
PROVIDER_ROUTES=
# Test mode through providers' TEST accounts (otherwise the built-in sandbox).
# Example: PROVIDER_TEST_ROUTES=card=mpgs_test
PROVIDER_TEST_ROUTES=

# ---- Card payments: Mastercard Gateway (MPGS) through your acquiring bank ----
# The bank gives you the gateway host (https only, e.g.
# https://ap-gateway.mastercard.com), a merchant id and an API password
# (Merchant Administration > Admin > Integration Settings). Enable it with
# PROVIDER_ROUTES=card=mpgs. Empty merchant id = not installed. At start-up
# paygate checks the gateway is OPERATING and the credentials are accepted
# (wrong credentials stop start-up).
MPGS_BASE_URL=
MPGS_MERCHANT_ID=
MPGS_API_PASSWORD=
MPGS_API_VERSION=100
# Name shown on Mastercard's payment page.
MPGS_MERCHANT_NAME=
# Webhook secret (Merchant Administration > Webhook Notifications). Webhooks
# need PUBLIC_BASE_URL on https; without them the return page and the expiry
# check still confirm payments.
MPGS_NOTIFICATION_SECRET=
# Currencies the bank settles for this merchant account (comma-separated).
MPGS_CURRENCIES=USD
# The bank's TEST merchant (usually TEST...), used only by test mode with
# PROVIDER_TEST_ROUTES=card=mpgs_test. Mastercard test cards work there.
MPGS_TEST_BASE_URL=https://test-gateway.mastercard.com
MPGS_TEST_MERCHANT_ID=
MPGS_TEST_API_PASSWORD=
MPGS_TEST_CURRENCIES=USD

# ---- KYC (merchant verification) ----
# Max 5 MB per file. The database stores object keys only; download links
# are created on every read and expire after 5 minutes.
# KYC_STORAGE: minio (production: S3-compatible object storage) or local
# (development: encrypted files in KYC_STORAGE_DIR).
KYC_STORAGE=local
KYC_STORAGE_DIR=./data/kyc
# MinIO / S3 (KYC_STORAGE=minio). MINIO_ENDPOINT is what the server uses;
# MINIO_PUBLIC_ENDPOINT is the host:port in download links (browsers).
# Use a dedicated access key limited to the bucket, not the root account.
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=kyc-documents
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MINIO_PUBLIC_USE_SSL=false
# Server-side encryption of every object (MinIO needs KMS: MINIO_KMS_SECRET_KEY).
KYC_S3_SSE=false
# Docker compose only: the MinIO server's own credentials and KMS key.
MINIO_ROOT_USER=paygate
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_KMS_SECRET_KEY=CHANGE_ME

# ---- Fayda (national digital ID) for the business owner ----
# Register as a relying party at https://partner.fayda.et (NBE-licensed
# institutions go through ETSwitch). Fayda gives a client id and you register
# your public key; FAYDA_PRIVATE_KEY is the private key (JWK, base64 JWK or PEM).
# Empty FAYDA_CLIENT_ID = Fayda disabled (owners upload an ID document).
FAYDA_ISSUER=https://esignet.ida.fayda.et
FAYDA_CLIENT_ID=
FAYDA_PRIVATE_KEY=
# Must match the redirect URI registered at Fayda. Default: PUBLIC_BASE_URL/kyc/fayda/callback
FAYDA_REDIRECT_URI=
# Sign-in method: mosip:idp:acr:generated-code (OTP, default), biometrics, linked-wallet
FAYDA_ACR=

# ---- MFA (authenticator app: Microsoft / Google Authenticator) ----
# Staff on /admin, merchant dashboard users on /v1, and payout requests need
# a session signed in with the authenticator. Keep all true in production.
REQUIRE_STAFF_MFA=true
REQUIRE_MERCHANT_MFA=true
REQUIRE_MFA_FOR_PAYOUTS=true

# ---- NATS security (microservices) ----
# Per-service credentials (.creds) and TLS. Empty = development only.
NATS_CREDS_FILE=
NATS_TLS_CA=
NATS_TLS_CERT=
NATS_TLS_KEY=

# ---- Monitoring ----
# Prometheus scrapes GET /metrics; with a token it must send
# "Authorization: Bearer <token>". Empty = open (keep /metrics off the internet).
METRICS_TOKEN=

# ---- Reconciliation ----
# The daily check covers the previous business day in this timezone and
# starts this long after local midnight (late provider callbacks arrive first).
RECONCILIATION_TIMEZONE=Africa/Addis_Ababa
RECONCILIATION_DAILY_AFTER=1h

# ---- Limits & integration ----
# Per API key / user (per process). 0 disables. Login/signup/refresh: per IP per minute.
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100
AUTH_RATE_LIMIT_PER_MIN=20
# Read the client IP from X-Forwarded-For (only behind your own proxy).
TRUST_PROXY=false
# Send Strict-Transport-Security (enable when the gateway is served over HTTPS).
HSTS=false
# Browser origins allowed to call the API (merchant dashboard), comma-separated.
CORS_ALLOWED_ORIGINS=
# Time a customer has to pay before a payment expires (per payment: expires_in_minutes).
PAYMENT_TTL=30m

# ---- Dev conveniences ----
WEBHOOK_ALLOW_INSECURE=false
ALLOW_MOCK_PROVIDER_IN_LIVE=false

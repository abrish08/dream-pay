# ---- Process ----
HTTP_ADDR=:8080
# "all", or a comma list: merchant,auth,provider,payment,refund,ledger,webhook,reconciliation
MODULES=all
# memory (MODULES=all only) or nats
BUS=memory
NATS_URL=nats://localhost:4222

# ---- Data ----
# Use your Postgres user/password. The database must exist (make db creates it).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gateway?sslmode=disable
# DB_URL_AUTH=postgres://.../gw_auth?sslmode=disable   (database per service)

# ---- Auth (DEV values only: generate your own with 'make keygen') ----
# Private key: ONLY the auth service.
AUTH_SIGNING_KEY=/9VGdLTrbK5xeuOwrEUuvY+epWSJyw6V0wGwGsEg060=
# Public key(s): EVERY service. Comma-separate old,new while rotating.
AUTH_PUBLIC_KEYS=oT1PA8eS/We0c2DbqJwA5ByeLAX/HQ9PEWXgLF/zqLw=
AUTH_KEY_CACHE_TTL=30s
# API key pepper (auth only). To rotate: move it to API_KEY_PEPPER_PREVIOUS,
# set a new API_KEY_PEPPER and increase API_KEY_PEPPER_VERSION.
API_KEY_PEPPER=pepper-dev-0123456789abcdef0123456789abcdef
API_KEY_PEPPER_VERSION=1
# First super_admin, created once if none exists. Change the password after login.
BOOTSTRAP_ADMIN_EMAIL=admin@paygate.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# ---- Other secrets (secret manager in production) ----
# 32 bytes, base64. DEV value only: generate your own with  openssl rand -base64 32
DATA_ENCRYPTION_KEY=a2tra2tra2tra2tra2tra2tra2tra2tra2tra2tra2s=

# ---- Providers ----
PUBLIC_BASE_URL=http://localhost:8080
CHAPA_BASE_URL=https://api.chapa.co
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# ---- Dev conveniences ----
WEBHOOK_ALLOW_INSECURE=false
ALLOW_MOCK_PROVIDER_IN_LIVE=false
